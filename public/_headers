# Honored by Cloudflare Pages / Netlify. GitHub Pages ignores this file
# and sends max-age=600 for hashed /assets/* (the 10-minute PSI finding).
# If pinjinpump.com is orange-clouded on Cloudflare, add a Cache Rule:
#   If URI Path starts with /assets/ → Edge TTL 1 year, Browser TTL 1 year.
/assets/*
  Cache-Control: public, max-age=31536000, immutable
/images/*
  Cache-Control: public, max-age=31536000, immutable
/en/
  Cache-Control: public, max-age=600, must-revalidate
/index.html
  Cache-Control: public, max-age=0, must-revalidate
